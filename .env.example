# Voxide (publishable key from voxide.app)
NEXT_PUBLIC_VOXIDE_PUBLIC_KEY=[NEXT_PUBLIC_VOXIDE_PUBLIC_KEY]

# Scholarxiv Papers API (server only — never NEXT_PUBLIC)
SCHOLARXIV_API_KEY= [YOUR_SCHOLAR_XIV_KEYS]

# Gemini (AI Studio) — debrief only, server side
GEMINI_API_KEY=[GCP_API_KEY]
# Optional. Default: gemini-2.0-flash
GEMINI_MODEL=gemini-3.8-flash
